# Copie para .env (o preparar.sh já faz isso) e ajuste se precisar.

# a porta no Windows (confira antes que está livre: LEIA-ME, passo 1).  No app: http://100.91.24.1:<esta porta>
NFSU2_PORTA=9091

# a pasta com o SPEED2.EXE.  Para o multiplayer basta o SPEED2.EXE sozinho (é o que o preparar.sh copia para
# ./jogo, 4,8 MB).  Só aponte para a pasta inteira do jogo (2,5 GB, fora do C:) se quiser também baixar os dados
# do jogo deste servidor.
NFSU2_JOGO=./jogo

# a pasta com os arquivos que o app baixa (Jogo/, Pacote/ e manifesto.json, ~1,7 GB; o preparar.sh monta).  Fora
# do C:, que é o disco apertado do GT-SRV: o D: serve (é cópia parada, só lida quando o app baixa)
NFSU2_ARQUIVOS=/mnt/d/nfsu2/arquivos

# os nomes que o servidor aceita no Host: o IP do Tailscale e o da LAN do GT-SRV (o nome *.ts.net não: o iPhone usa o IP)
NFSU2_HOST=100.91.24.1,10.0.0.129

# jogadores ao mesmo tempo
NFSU2_MAX_PEERS=32

# a imagem do servidor: a mesma versão do pacote do app (sha-<7 primeiras letras do commit do pacote.json)
NFSU2_IMAGEM=ghcr.io/th0mk/nfsu2-web-rs:sha-82742d0
